@base = http://localhost:3000
@remote = https://ws-project-2.onrender.com


//***************************
// CUSTOMERS routes (LOCAL) *
//***************************

### list customers in DB
get {{base}}/customers

### insert new customer to DB
post {{base}}/customers/writeNewCustomer HTTP/1.1 
content-type: application/json

{
    "firstName":"Robert",
    "lastName":"Plant",
    "email":"classicrock@gmail.com",
    "phoneNumber":"123-456-2345",
    "lastOrderDate":""
}

### update customer in DB
put {{base}}/customers/updateCustomer/68ed60e14244ffa80b71dbde HTTP/1.1 
content-type: application/json

{
    "firstName":"Marshall",
    "lastName":"Mathers",
    "email":"pottymouth@eminem.com",
    "phoneNumber":"123-555-0000",
    "lastOrderDate":"2025-10-13"
}

### delete customer in DB
delete {{base}}/customers/deleteCustomer/68eff417ccfe7d3dd5d640e0 HTTP/1.1

### update last order date for customer in DB
patch {{base}}/customers/lastOrderDate/68ed589ded9a4f9a24b2b164 HTTP/1.1 
content-type: application/json

{
    "lastOrderDate":""
}

